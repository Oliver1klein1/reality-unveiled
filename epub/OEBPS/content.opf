    <metadata xmlns:dc="http://purl.org/dc/elements/1.1/" xmlns:opf="http://www.idpf.org/2007/opf">
        <dc:identifier id="book-id" opf:scheme="UUID">book_20251210_014837</dc:identifier>
        <dc:title>Reality Unveiled</dc:title>
        <dc:creator opf:file-as="Ansilo Boff" opf:role="aut">Ansilo Boff</dc:creator>
        <dc:publisher>Truth Beyond Tradition</dc:publisher>
        <dc:date opf:event="publication">2025</dc:date>
        <dc:language>en</dc:language>
        <dc:subject>Consciousness, Quantum Physics, Manifestation, Abundance, Transformation, Jesus' Hidden Teachings, Awareness, Oneness, Divinity</dc:subject>
        <dc:description>Reality Unveiled explores Jesus’ most empowering teaching: the Kingdom of God within you. Blending the Gospels, consciousness studies, and modern physics, the book reveals how perception shapes reality and why Jesus’ words “YOU ARE GODS” point to your innate creative power. This is a guide to releasing inherited fear, awakening inner abundance, and discovering your identity as a divine co-creator in a conscious universe.</dc:description>
